{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naail.example/schemas/evidence-passport-0.1.json",
  "title": "NAAIL Evidence Passport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "passport_id",
    "created_at",
    "task",
    "generator",
    "sources",
    "claims",
    "calculations",
    "reviews",
    "conflicts",
    "human_approval",
    "final_status",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "passport_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "task": {
      "type": "object",
      "required": [
        "task_id",
        "description",
        "risk_level"
      ],
      "additionalProperties": true,
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      }
    },
    "generator": {
      "type": "object",
      "required": [
        "agent_id",
        "provider",
        "model",
        "version"
      ],
      "additionalProperties": true,
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "uri",
          "retrieved_at"
        ],
        "additionalProperties": true,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "text",
          "status",
          "evidence_refs"
        ],
        "additionalProperties": true,
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "VERIFIED",
              "REPLICATED",
              "INFERRED",
              "UNRESOLVED",
              "FALSIFIED",
              "DRAFT"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "calculations": {
      "type": "array"
    },
    "reviews": {
      "type": "array"
    },
    "conflicts": {
      "type": "array"
    },
    "human_approval": {
      "type": "object",
      "required": [
        "required",
        "status"
      ],
      "additionalProperties": true,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "not_required"
          ]
        },
        "approver": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "final_status": {
      "enum": [
        "VERIFIED",
        "REPLICATED",
        "INFERRED",
        "UNRESOLVED",
        "FALSIFIED",
        "DRAFT"
      ]
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
