{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Saehon/Saeid-Homayoun/discovery/study_manifest.schema.json",
  "title": "ECONOVA-S Scientific Discovery Study Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "study_id",
    "research_goal",
    "study_stage",
    "evidence_class",
    "methods",
    "gates",
    "integrity",
    "artifacts",
    "human_gate",
    "discovery_claim_allowed"
  ],
  "properties": {
    "study_id": {"type": "string", "minLength": 1},
    "research_goal": {"type": "string", "minLength": 1},
    "study_stage": {
      "enum": ["concept", "preregistered", "executing", "validated", "replicated", "human_review", "approved", "retired"]
    },
    "evidence_class": {
      "enum": ["theoretical", "descriptive", "associational", "predictive", "causal", "structural_equilibrium", "replicated"]
    },
    "methods": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "co_scientist_style",
          "era_style",
          "alphaevolve_inspired",
          "computational_discovery",
          "alphafold_inspired_latent_structure",
          "science_one_chain_of_evidence",
          "coe_audit",
          "mirendil_inspired_closed_loop",
          "ai_to_ai_review",
          "dag_governance"
        ]
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "literature_validation",
        "hypothesis_tournament",
        "dag_governance",
        "empirical_conversion",
        "search_integrity",
        "latent_structure_validation",
        "provenance",
        "identification",
        "replication_or_oos",
        "adversarial_review",
        "falsification",
        "chain_of_evidence",
        "coe_audit",
        "economic_significance",
        "welfare_interpretation",
        "reproducibility"
      ],
      "properties": {
        "literature_validation": {"type": "boolean"},
        "hypothesis_tournament": {"type": "boolean"},
        "dag_governance": {"type": "boolean"},
        "empirical_conversion": {"type": "boolean"},
        "search_integrity": {"type": "boolean"},
        "latent_structure_validation": {"type": "boolean"},
        "provenance": {"type": "boolean"},
        "identification": {"type": "boolean"},
        "replication_or_oos": {"type": "boolean"},
        "adversarial_review": {"type": "boolean"},
        "falsification": {"type": "boolean"},
        "chain_of_evidence": {"type": "boolean"},
        "coe_audit": {"type": "boolean"},
        "economic_significance": {"type": "boolean"},
        "welfare_interpretation": {"type": "boolean"},
        "reproducibility": {"type": "boolean"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_frozen",
        "evaluator_frozen",
        "holdout_isolated",
        "failure_memory_retained",
        "code_data_lineage_recorded",
        "p_value_optimization_prohibited",
        "external_method_execution_truthful",
        "ai_review_independence_level"
      ],
      "properties": {
        "protocol_frozen": {"type": "boolean"},
        "evaluator_frozen": {"type": "boolean"},
        "holdout_isolated": {"type": "boolean"},
        "failure_memory_retained": {"type": "boolean"},
        "code_data_lineage_recorded": {"type": "boolean"},
        "p_value_optimization_prohibited": {"type": "boolean"},
        "external_method_execution_truthful": {"type": "boolean"},
        "ai_review_independence_level": {
          "enum": ["role_only", "context_isolated", "model_diverse", "code_path_independent", "human_external"]
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_passport",
        "human_gate_record",
        "hypothesis_tournament",
        "empirical_manifest",
        "provenance_manifest",
        "search_registry",
        "replication_report",
        "red_team_report",
        "falsification_report",
        "chain_of_evidence",
        "coe_audit",
        "failure_memory"
      ],
      "properties": {
        "evidence_passport": {"type": "string", "minLength": 1},
        "human_gate_record": {"type": "string", "minLength": 1},
        "hypothesis_tournament": {"type": ["string", "null"]},
        "empirical_manifest": {"type": ["string", "null"]},
        "provenance_manifest": {"type": ["string", "null"]},
        "search_registry": {"type": ["string", "null"]},
        "replication_report": {"type": ["string", "null"]},
        "red_team_report": {"type": ["string", "null"]},
        "falsification_report": {"type": ["string", "null"]},
        "chain_of_evidence": {"type": ["string", "null"]},
        "coe_audit": {"type": ["string", "null"]},
        "failure_memory": {"type": ["string", "null"]}
      }
    },
    "human_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "reviewer", "decision_date", "decision", "independence_statement"],
      "properties": {
        "approved": {"type": "boolean"},
        "reviewer": {"type": "string"},
        "decision_date": {"type": ["string", "null"]},
        "decision": {"enum": ["REVISE", "PROCEED", "APPROVE_FOR_SCIENTIFIC_CLAIM"]},
        "independence_statement": {"type": "string"}
      }
    },
    "discovery_claim_allowed": {"type": "boolean"}
  }
}
